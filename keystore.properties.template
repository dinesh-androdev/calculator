# Local-only signing & Firebase credentials. This file is git-ignored — never commit it.
# In CI the same keys are supplied as environment variables from GitHub Secrets.

# --- Signing (release.jks lives in the project root) ---
KEYSTORE_FILE=release.jks
KEYSTORE_PASSWORD=CHANGE_ME
KEY_ALIAS=CHANGE_ME
KEY_PASSWORD=CHANGE_ME

# --- Firebase App Distribution ---
# App ID from Firebase console (Project settings > your Android app), e.g. 1:1234567890:android:abc123
FIREBASE_APP_ID=CHANGE_ME
FIREBASE_SERVICE_ACCOUNT_FILE=CHANGE-ME
